# Copy to .env.local and fill in values. Never commit .env.local.
# Names only here; each setup step adds the variables it needs.

# Flyway (migrator role; local Supabase: run `supabase status`)
# FLYWAY_URL is a JDBC URL: jdbc:postgresql://<host>:<port>/postgres
# Locally FLYWAY_USER is postgres until Phase 1 creates the migrator role.
FLYWAY_URL=
FLYWAY_USER=
FLYWAY_PASSWORD=

# Backend runtime database connection (app_user role, created in Phase 1; never postgres or service_role)
DB_URL=
DB_USER=
DB_PASSWORD=

# Supabase Auth (backend verifies tokens)
SUPABASE_URL=

# Frontend (publishable key only; never the secret key)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=
