# Copy to .env.local and fill in values. Never commit .env.local.
# Names only here; each setup step adds the variables it needs.

# Flyway, as the migrator role (create roles and set passwords first: db/bootstrap/README.md)
# FLYWAY_URL is a JDBC URL: jdbc:postgresql://<host>:<port>/postgres
FLYWAY_URL=
FLYWAY_USER=
FLYWAY_PASSWORD=

# Backend runtime database connection, as the app_user role; never postgres or service_role
# Hosted environments use Supabase's transaction pooler; the app sets prepareThreshold=0 itself.
# Never put the password in DB_URL: the app (and JobRunr's pool) refuse to start if a URL carries one.
DB_URL=
DB_USER=
DB_PASSWORD=

# Supabase Auth: the backend verifies access tokens against ${SUPABASE_URL}/auth/v1 and its JWKS (required to start).
# Local: http://127.0.0.1:54321
SUPABASE_URL=

# The React app's address, used to build invite links (local: http://localhost:5173)
NORTHSTAR_APP_URL=

# Email (step 1.12). Only the worker sends email, so these are required only when NORTHSTAR_WORKER_ENABLED=true.
# NORTHSTAR_EMAIL_PROVIDER: resend (default) or mailpit. mailpit is for local development only: it posts to the
# Mailpit that `supabase start` runs (http://127.0.0.1:54324, open it to read the invite) and refuses any other host.
NORTHSTAR_EMAIL_PROVIDER=
# Sender, e.g. Northstar <invites@mail.example.com>, on the verified sending sub-domain
NORTHSTAR_EMAIL_FROM=
# Resend API key (sending access); not needed with mailpit
RESEND_API_KEY=
# Only to point mailpit elsewhere on this machine (default http://127.0.0.1:54324)
NORTHSTAR_MAILPIT_URL=
# 32+ random bytes, base64 (e.g. openssl rand -base64 32). Invite tokens are derived from it; a platform secret.
NORTHSTAR_INVITE_TOKEN_KEY=

# JobRunr's own login (db/bootstrap/README.md): may use only the jobrunr schema. Same DB_URL as the app.
JOBRUNR_DB_USER=
JOBRUNR_DB_PASSWORD=

# true only in the worker container (and locally, to run jobs); API containers only create jobs
NORTHSTAR_WORKER_ENABLED=

# Frontend (publishable key only; never the secret key)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=
